// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum UserRole {
  USER
  PHARMACY
  ADMIN
}

enum PharmacyStatus {
  PENDING
  VALIDATED
  SUSPENDED
  REJECTED
}

// =====================
// Models
// =====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(USER)

  // Relations
  favorites    Favorite[]
  reviews      Review[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
}

model Pharmacy {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String           @unique
  street          String
  city            String
  zipCode         String
  country         String
  latitude        Float
  longitude       Float
  phone           String
  averageRating   Float            @default(0)
  status          PharmacyStatus   @default(PENDING)
  operatingHours  Json?            // Stocké en JSON pour simplifier

  // Relations
  medications      PharmacyMedication[]
  reviews          Review[]
  favorites        Favorite[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status])
  @@index([city])
}

model Medication {
  id           String   @id @default(cuid())
  name         String   @unique
  genericName  String
  form         String   // Comprimé, Gélule, Sirop, etc.
  dosage       String
  manufacturer String

  // Relations
  pharmacies PharmacyMedication[]
  favorites  Favorite[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model PharmacyMedication {
  id            String   @id @default(cuid())
  pharmacyId    String
  medicationId  String
  isAvailable   Boolean  @default(false)
  // NB: price et quantity sont intentionnellement ABSENTS pour la confidentialité

  // Relations
  pharmacy   Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([pharmacyId, medicationId])
  @@index([pharmacyId])
  @@index([medicationId])
}

model Review {
  id         String   @id @default(cuid())
  pharmacyId String
  userId     String
  rating     Int      @db.SmallInt // 1-5
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([userId])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  pharmacyId   String?
  medicationId String?
  createdAt    DateTime @default(now())

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pharmacyId])
  @@index([medicationId])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
